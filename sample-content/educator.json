      "headline": "Think of it like a waiter",
      "body": [
        { "text": "You order food. The waiter takes your request to the kitchen and brings back exactly what you asked for." }
      ]
    },
    {
      "type": "content",
      "number": "02",
      "headline": "Your app does the same",
      "body": [
        { "text": "Your app sends a request." },
        { "kind": "block", "lines": ["REQUEST  → your app asks for data", "RESPONSE ← API sends back the result"] },
        { "text": "The API handles everything in between." }
      ]
    },
